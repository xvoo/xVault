# xVault — copy to `.env` (in the working directory) and adjust.
# Real environment variables take precedence over this file.

SERVER_HOST=127.0.0.1
SERVER_PORT=58951
# Public URL. Use https:// in production: it enables Secure/__Host- cookies
# and HSTS, and it is the only origin allowed to call the API.
SERVER_URL=http://localhost:58951

# Sign-ups are closed by default. With REGISTRATION_CODE set (16+ chars),
# only people who know the code can create a vault.
ALLOW_REGISTRATION=false
# REGISTRATION_CODE=

# Set to true only when the backend is reachable exclusively through a
# reverse proxy (Caddy, nginx) that sets X-Forwarded-For.
TRUST_PROXY=false

# Optional:
# XVAULT_DB_PATH=./data/xVault.sqlite
# XVAULT_DIST_DIR=./dist
# XVAULT_CONFIG_PATH=./config.json
# ALLOWED_ORIGINS=http://localhost:5173
